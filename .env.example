# Copy to .env and fill in your values

# ── PostgreSQL ───────────────────────────────────────────
# Hosted Postgres (Neon/Vercel/Supabase) đặt sẵn POSTGRES_URL thì bỏ qua PG_* bên dưới.
# POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DB=highlands_coffee

# ── Auth ─────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-min-32-chars  # generate: python -c "import secrets; print(secrets.token_hex(32))"
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Chatbot LLM ──────────────────────────────────────────
# Có GROQ_API_KEY thì dùng Groq; để trống thì fallback sang Ollama local.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Chatbot RAG embedding (Google AI Studio) ─────────────
# Lấy key tại https://aistudio.google.com/apikey — KHÁC với GOOGLE_CLIENT_ID ở trên.
# Để trống thì chatbot tự chạy bằng TF-IDF, không lỗi.
GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
# Đổi số chiều bắt buộc phải chạy lại migrate_embeddings.py --rebuild
GEMINI_EMBED_DIM=768
# Trọng số nhánh semantic khi trộn điểm (0 = thuần TF-IDF, 1 = thuần embedding)
RAG_HYBRID_ALPHA=0.7
# Ngưỡng điểm tối thiểu để hiện product card trong chat
RAG_MIN_SCORE=0.38

# ── Gmail SMTP (tùy chọn) ────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
