# Copy to .env and fill in your values
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=highlands_coffee
SECRET_KEY=your-random-secret-key-min-32-chars  # generate: python -c "import secrets; print(secrets.token_hex(32))"
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Tìm kiếm bằng hình ảnh — đăng ký free tại https://jina.ai (10M token, không cần thẻ)
# Bỏ trống thì tính năng tìm bằng ảnh tự tắt, phần còn lại của app vẫn chạy bình thường
JINA_API_KEY=jina_your_api_key_here
